# Copy to .env locally. Never commit real tokens, API keys, or MongoDB credentials.
BOT_TOKEN=
# Enable only with your separate local test bot, or during production rollout.
SEND_NOTIFICATIONS=false
MONGODB_URI=mongodb://127.0.0.1:27017/ton-notify-dev
TON_INDEX_URL=https://toncenter.com/api/v3
TON_INDEX_API_KEY=
NOTIFICATIONS_CHANNEL_ID=
MIN_TRANSACTION_AMOUNT=50000
SCAN_INTERVAL_MS=5000
SCAN_LAG_BLOCKS=16
SCAN_REPLAY_BLOCKS=120
SCAN_START_SEQNO=
SCAN_PAGE_SIZE=500
HTTP_TIMEOUT_MS=15000
TON_REQUESTS_PER_SECOND=80
TON_HTTP_CONCURRENCY=8
SCAN_BLOCK_CONCURRENCY=4
